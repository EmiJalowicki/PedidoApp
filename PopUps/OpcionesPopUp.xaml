<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PedidoApp.PopUps.OpcionesPopUp"
    WidthRequest="240"
    HeightRequest="160">

    <Border
        BackgroundColor="White"
        StrokeThickness="0"
        Padding="5">

        <VerticalStackLayout
            Spacing="0">

            <Button
                Text="Menú"
                FontSize="22"
                FontFamily="Aptos"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                BackgroundColor="Transparent"
                TextColor="Black"
                Padding="10,5"
                Clicked="Menu_Clicked"/>
            <Button
                Text="Nuevo pedido"
                FontSize="22"
                FontFamily="Aptos"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                BackgroundColor="Transparent"
                TextColor="Black"
                Padding="10,5"
                Clicked="NuevoPedido_Clicked"/>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>