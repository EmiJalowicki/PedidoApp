<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PedidoApp.Paginas.MenuPage"
             Title="Menú">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <!-- TÍTULO -->
            <Label
                Text="MENÚ"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />


            <!-- ==================== -->
            <!-- PIZZAS -->
            <!-- ==================== -->

            <Border
                StrokeShape="RoundRectangle 10"
                Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="15,12"
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource Primario}">

                        <Label
                            Text="🍕  PIZZAS"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="PizzaFlecha"
                            Grid.Column="1"
                            Text="▶"
                            FontSize="18"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="PizzaHeader_Tapped" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <VerticalStackLayout
                        x:Name="PizzaContenido"
                        IsVisible="False"
                        Padding="15,5,15,15"
                        Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Muzzarella"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$8.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Napolitana"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$10.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Jamón y Morrones"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$11.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Fugazzeta"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$10.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Calabresa"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$11.000"
                                   FontSize="17" />
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ==================== -->
            <!-- EMPANADAS -->
            <!-- ==================== -->

            <Border
                StrokeShape="RoundRectangle 10"
                Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="15,12"
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource Secundario}">

                        <Label
                            Text="🥟  EMPANADAS"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="EmpanadaFlecha"
                            Grid.Column="1"
                            Text="▶"
                            FontSize="18"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="EmpanadaHeader_Tapped" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <VerticalStackLayout
                        x:Name="EmpanadaContenido"
                        IsVisible="False"
                        Padding="15,5,15,15"
                        Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Carne"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$1.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Carne cortada a cuchillo"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$1.700"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Jamón y Queso"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$1.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Pollo"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$1.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Humita"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$1.400"
                                   FontSize="17" />
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ==================== -->
            <!-- MILANESAS -->
            <!-- ==================== -->

            <Border
                StrokeShape="RoundRectangle 10"
                Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="15,12"
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource Terciario}">

                        <Label
                            Text="🍗  MILANESAS"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="MilanesaFlecha"
                            Grid.Column="1"
                            Text="▶"
                            FontSize="18"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="MilanesaHeader_Tapped" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <VerticalStackLayout
                        x:Name="MilanesaContenido"
                        IsVisible="False"
                        Padding="15,5,15,15"
                        Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Simple"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$8.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Napolitana"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$10.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Fugazzeta"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$11.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Con Papas"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$11.500"
                                   FontSize="17" />
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ==================== -->
            <!-- BEBIDAS -->
            <!-- ==================== -->

            <Border
                StrokeShape="RoundRectangle 10"
                Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="15,12"
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource Primario}">

                        <Label
                            Text="🥤  BEBIDAS"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="BebidaFlecha"
                            Grid.Column="1"
                            Text="▶"
                            FontSize="18"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="BebidaHeader_Tapped" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <VerticalStackLayout
                        x:Name="BebidaContenido"
                        IsVisible="False"
                        Padding="15,5,15,15"
                        Spacing="10">

                        <!-- SIN ALCOHOL -->

                        <Label
                            Text="SIN ALCOHOL"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,0,0,2" />

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Coca Cola"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="500 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$2.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Coca Cola"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="1,5 L"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$3.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Sprite"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="500 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$2.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Agua"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="500 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$1.500"
                                   FontSize="17" />
                        </Grid>


                        <!-- ALCOHOLICAS -->

                        <Label
                            Text="ALCOHÓLICAS"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,10,0,2" />

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Quilmes"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="473 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$3.000"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Corona"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="330 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$3.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,80,Auto">
                            <Label Text="Stella Artois"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="473 ml"
                                   FontSize="17" />

                            <Label Grid.Column="2"
                                   Text="$3.800"
                                   FontSize="17" />
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ==================== -->
            <!-- HELADOS -->
            <!-- ==================== -->

            <Border
                StrokeShape="RoundRectangle 10"
                Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Grid
                        Padding="15,12"
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource Secundario}">

                        <Label
                            Text="🍦  HELADOS"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="HeladoFlecha"
                            Grid.Column="1"
                            Text="▶"
                            FontSize="18"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="HeladoHeader_Tapped" />
                        </Grid.GestureRecognizers>

                    </Grid>

                    <VerticalStackLayout
                        x:Name="HeladoContenido"
                        IsVisible="False"
                        Padding="15,5,15,15"
                        Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="1/4 kg"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$4.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="1/2 kg"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$7.500"
                                   FontSize="17" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="1 kg"
                                   FontSize="17" />

                            <Label Grid.Column="1"
                                   Text="$13.000"
                                   FontSize="17" />
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>