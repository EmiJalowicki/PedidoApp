<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PedidoApp.Vistas"
             x:Class="PedidoApp.Paginas.AgregarMenuPage"
             Title="Agregar al Menú">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- Título -->
            <Label
                Text="Nuevo Artículo"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Categoría -->
            <Label
                Text="Categoría"
                FontSize="18" />

            <Picker
                x:Name="CategoriaPicker"
                Title="Seleccioná una categoría" />

            <!-- Formulario del Artículo -->
            <local:ItemMenuView
                x:Name="ItemMenu"
                IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>