<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PedidoApp.TicketView">
    <Border
        BackgroundColor="White"
        Padding="15">

        <VerticalStackLayout
            Spacing="10">
            <!-- Encabezado -->
            <Label
                Text="La Cocina de So"
                FontAttributes="Bold"
                FontSize="24"
                HorizontalTextAlignment="Center"
                FontFamily="Aptos"/>
            <Label
                Text="Virgen de Itatí 1621, Sol de Oro"
                HorizontalTextAlignment="Center"/>
            <Label
                Text="+54 9 11-5920-3972"
                HorizontalTextAlignment="Center"/>
            <Label
                Text="2134-4672"
                HorizontalOptions="Center"/>
            <!-- Fecha -->
            <Label
                x:Name="FechaLabel"
                HorizontalTextAlignment="Center"/>
            <BoxView HeightRequest="1"/>
            
            <!-- Encabezados -->
            <Grid
                ColumnDefinitions="40,*,100"
                ColumnSpacing="5">
                
                <!-- C. -->
                <Label
                    Grid.Column="0"
                    Text="C."
                    FontAttributes="Bold"
                    HorizontalOptions="Center"/>
                <!-- Pedido -->
                <Label
                    Grid.Column="1"
                    Text="Pedido"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"/>
                <!-- $$$ -->
                <Label
                    Grid.Column="2"
                    Text="Precio"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="End"/>

            </Grid>
            
            <!-- ITEMS -->
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            ColumnDefinitions="40,*,100"
                            ColumnSpacing="5"
                            Padding="0,3">
                            <!-- CANTIDAD -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding Cantidad}"
                                HorizontalTextAlignment="Center"/>
                            <!-- PEDIDO -->
                            <Label
                                Grid.Column="1"
                                Text="{Binding Consumible}"
                                HorizontalTextAlignment="Center"/>
                            <!-- PRECIO -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding SubtotalFormateado}"
                                HorizontalTextAlignment="End"/>

                        </Grid>
                        
                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <BoxView
                HeightRequest="1"/>

            <!-- TOTAL -->
            <Grid
                ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="TOTAL:"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="End"
                    VerticalTextAlignment="Center"/>

                <Label
                    Grid.Column="1"
                    Text="{Binding TotalFormateado}"
                    FontAttributes="Bold"
                    FontSize="Large"
                    Margin="10,0,0,0"/>

            </Grid>

            <Label
                Text="¡Gracias por tu compra!"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </Border>

</ContentView>
